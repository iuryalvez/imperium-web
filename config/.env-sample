# ------------------------------------------------------------------------------
# OPÇÃO 1: DESENVOLVIMENTO LOCAL (Host nativo)
# ------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Development
# REACT_APP_API_BASE_URL=http://localhost:5050
# FRONT_PORT=80
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=imperium_db
# DB_USER=admin
# DB_PASS=admin
# Jwt__Issuer=http://localhost:5050
# Jwt__Audience=http://localhost:5050
# Jwt__Key=uma_chave_local_com_mais_de_256_bits_12345
# Jwt__ExpiresInMinutes=60
# Jwt__RenewInMinutesLeft=5
# SwaggerAuth__Username=admin
# SwaggerAuth__Password=admin
# CookieSecure=false
# AllowedHosts=localhost
# REACT_APP_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

