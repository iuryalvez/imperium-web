# ==============================================================================
# ESCOLHA O AMBIENTE: Descomente apenas o bloco que deseja utilizar
# ==============================================================================

# ------------------------------------------------------------------------------
# OPÇÃO 1: DESENVOLVIMENTO LOCAL (Host nativo)
# ------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Development
# REACT_APP_API_BASE_URL=http://localhost:5050
# FRONT_PORT=80
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=imperium_db
# DB_USER=admin
# DB_PASS=admin
# Jwt__Issuer=http://localhost:5050
# Jwt__Audience=http://localhost:5050
# Jwt__Key=uma_chave_local_com_mais_de_256_bits_12345
# Jwt__ExpiresInMinutes=60
# Jwt__RenewInMinutesLeft=5
# SwaggerAuth__Username=admin
# SwaggerAuth__Password=admin
# EmailSettings__SmtpServer=smtp.gmail.com
# EmailSettings__SmtpPort=587
# EmailSettings__SmtpUser=bris.suporte.evz@ufg.br
# EmailSettings__SmtpPass=            (vazio: em Development o link vai para o log)
# EmailSettings__FromAddress=         (opcional; padrão = SmtpUser)
# EmailSettings__FromName=Suporte IMPERIUM
# FrontendUrl=http://localhost:3000
# CookieSecure=true
# Cookie__Name=auth_token
# Cookie__Path=/
# Jwt__MaxSessionDays=30
# Cors__AllowedOrigins__0=http://localhost:3000
# AllowedHosts=localhost
# REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# OPÇÃO 2: PRODUÇÃO (Servidor - Docker)
# ------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# REACT_APP_API_BASE_URL=https://imperium.evz.ufg.br
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=
# POSTGRES_DB=imperium_prod
# PGADMIN_DEFAULT_EMAIL=bris.suporte.evz@ufg.br
# PGADMIN_DEFAULT_PASSWORD=
# ConnectionStrings__DefaultConnection=Host=db-imperium;Port=5432;Database=imperium_prod;Username=admin;Password=
# Jwt__Issuer=https://imperium.evz.ufg.br
# Jwt__Audience=https://imperium.evz.ufg.br
# Jwt__Key=
# Jwt__ExpiresInMinutes=60
# Jwt__RenewInMinutesLeft=5
# SwaggerAuth__Username=admin
# SwaggerAuth__Password=
# EmailSettings__SmtpServer=smtp.gmail.com
# EmailSettings__SmtpPort=587
# EmailSettings__SmtpUser=bris.suporte.evz@ufg.br
# EmailSettings__SmtpPass=            (senha de app do Google, sem espaços)
# EmailSettings__FromAddress=         (opcional; padrão = SmtpUser)
# EmailSettings__FromName=Suporte IMPERIUM
# FrontendUrl=https://imperium.evz.ufg.br
# CookieSecure=true
# Cookie__Name=__Host-imperium_auth   (homologação: imperium_auth_dev)
# Cookie__Path=/                      (homologação: /dev)
# Jwt__MaxSessionDays=30
# Cors__AllowedOrigins__0=https://imperium.evz.ufg.br
# AllowedHosts=imperium.evz.ufg.br;localhost
# REACT_APP_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
